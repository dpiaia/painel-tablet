<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Só LEITURA do calendário. O app nunca escreve, nunca aceita convite,
         nunca apaga — o painel é vidro também aqui. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_my_calendar"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/rede">

        <activity
            android:name=".PainelActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- HOME para o painel poder virar a tela inicial do tablet:
                     assim, mesmo que alguém saia do app, o aparelho volta para
                     ele em vez de parar no lançador do Android. Opcional —
                     quem não quiser é só não escolher como padrão. -->
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
